# Environment variables configuration for Audit Trail Ledger

# Server Environment
NODE_ENV=development
PORT=3000

# Database Configuration (Standalone or Replica Set)
MONGODB_URI=mongodb://localhost:27017/audit-trail-ledger
# MONGO_WRITE_CONCERN=majority # Uncomment for production replica sets

# Distributed Message Broker (RabbitMQ / AMQP)
# By default, system uses resilient in-memory fallback.
# Set ENABLE_RABBITMQ=true or specify RABBITMQ_URL to connect to RabbitMQ broker.
ENABLE_RABBITMQ=false
RABBITMQ_URL=amqp://localhost:5672

# Distributed Cache (Redis)
# By default, system uses resilient in-memory fallback cache.
# Set ENABLE_REDIS=true or specify REDIS_HOST to connect to Redis cache.
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug
